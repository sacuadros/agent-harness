{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "args": ["{claude_hooks}/harness_guards.py", "bash", "--copilot"],
        "timeoutSec": 5
      },
      {
        "type": "command",
        "args": ["{claude_hooks}/harness_guards.py", "backup"],
        "timeoutSec": 5
      }
    ]
  }
}
