{
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{python}",
          "args": ["{claude_hooks}/engram_auto_enroll.py"],
          "timeout": 120
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "{python}",
          "args": ["{claude_hooks}/enforce_memory_graph.py", "stop"],
          "timeout": 5
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Grep|Glob|Bash|PowerShell",
      "hooks": [
        {
          "type": "command",
          "command": "{python}",
          "args": ["{claude_hooks}/enforce_memory_graph.py", "pretool"],
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Bash|PowerShell",
      "hooks": [
        {
          "type": "command",
          "command": "{python}",
          "args": ["{claude_hooks}/harness_guards.py", "bash"],
          "timeout": 5,
          "onFailure": "block"
        }
      ]
    },
    {
      "matcher": "mcp__.*",
      "hooks": [
        {
          "type": "command",
          "command": "{python}",
          "args": ["{claude_hooks}/harness_guards.py", "mcp"],
          "timeout": 5,
          "onFailure": "block"
        }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "{python}",
          "args": ["{claude_hooks}/harness_guards.py", "backup"],
          "timeout": 5,
          "onFailure": "block"
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{python}",
          "args": ["{claude_hooks}/engram_auto_enroll.py"],
          "timeout": 120
        }
      ]
    }
  ]
}
