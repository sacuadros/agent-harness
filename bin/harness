#!/usr/bin/env python3
"""Render the agent harness from one source and install it into each agent's home.

  harness render <agent>              print the rendered instructions for one agent
  harness install [--home] [--dry-run] [--agents a,b | --choose]
                                      write changed files for the agents you pick, backing up what they replace
  harness restore <stamp> [--home]    undo one install from its backup manifest
  harness check [--home]              exit 1 if anything installed drifted or is broken
  harness doctor [--home]             report leftovers and version drift (read-only)
"""
import sys

if sys.version_info < (3, 11):  # before importing tomllib, which arrived in 3.11
    sys.exit('agent-harness needs Python 3.11 or newer; set `python` in ~/.agent-harness/config.toml '
             'for the hooks and run bin/harness with that interpreter.')

import argparse
import json
import os
import queue
import re
import shlex
import shutil
import subprocess
import threading
import http.client
import urllib.request
from datetime import datetime
import tomllib
from pathlib import Path

try:
    import curses
except ImportError:  # Windows Python ships without it: `pick_text` takes over
    curses = None

REPO = Path(__file__).resolve().parent.parent
INSTRUCTIONS = REPO / 'core' / 'instructions'
SKILLS = REPO / 'core' / 'skills'
SUBAGENTS = REPO / 'core' / 'agents'
HOOKS = REPO / 'core' / 'hooks'
PLUGINS = tomllib.loads((REPO / 'core' / 'plugins.toml').read_text(encoding='utf-8'))
PERMISSIONS = tomllib.loads((REPO / 'core' / 'permissions.toml').read_text(encoding='utf-8'))
# Hook scripts each agent's hook config runs (Codex also calls the Claude copies).
HOOK_SCRIPTS = {
    '.claude/hooks': ('harness_guards.py', 'enforce_memory_graph.py', 'engram_auto_enroll.py'),
    '.codex/hooks': ('engram_auto_enroll.py',),
}

AGENTS = {
    'claude': {'path': '.claude/CLAUDE.md', 'skills': '.claude/skills', 'marker': 'claude-native',
               'vars': {'agent': 'Claude Code', 'cmd': '/'}},
    # ~/.agents/skills is Codex's documented user folder (~/.codex/skills is deprecated); Copilot and Pi read it too.
    'codex': {'path': '.codex/AGENTS.md', 'skills': '.agents/skills', 'marker': 'codex-native',
              'vars': {'agent': 'Codex', 'cmd': '$'}},
    # OpenCode reads ~/.claude/skills and ~/.agents/skills itself, so it gets no copy of its own.
    'opencode': {'path': '.config/opencode/AGENTS.md', 'skills': None, 'marker': 'opencode-native',
                 'vars': {'agent': 'OpenCode', 'cmd': '/'}},
    # Copilot reads ~/.agents/skills itself.
    'copilot': {'path': '.copilot/copilot-instructions.md', 'skills': None, 'marker': 'copilot-native',
                'vars': {'agent': 'GitHub Copilot', 'cmd': '/'}},
    # Pi reads ~/.agents/skills itself.
    'pi': {'path': '.pi/agent/AGENTS.md', 'skills': None, 'marker': 'pi-native',
           'vars': {'agent': 'Pi', 'cmd': '/skill:'}},
}


# Agent configs the harness merges into; they must stay parseable.
CONFIGS = {
    '.claude/settings.json': json.loads,
    '.codex/config.toml': tomllib.loads,
    '.codex/hooks.json': json.loads,
    '.config/opencode/opencode.json': json.loads,
    '.pi/agent/settings.json': json.loads,
    '.copilot/mcp-config.json': json.loads,
}


def sections(agent):
    """Yield (name, template) in file order; `NN-name.<agent>.md` overrides `NN-name.md`."""
    chosen = {}
    for f in sorted(INSTRUCTIONS.glob('*.md')):
        parts = f.name.split('.')
        if len(parts) == 3 and parts[1] != agent:
            continue
        chosen[parts[0]] = f
    for stem, f in sorted(chosen.items()):
        yield stem.split('-', 1)[1], f.read_text(encoding='utf-8')


def render(agent):
    spec = AGENTS[agent]
    blocks = []
    for name, body in sections(agent):
        for key, value in spec['vars'].items():
            body = body.replace('{{' + key + '}}', value)
        blocks.append(f'<!-- {spec["marker"]}:{name} -->\n{body}<!-- /{spec["marker"]}:{name} -->\n')
    return '\n'.join(blocks)


def agent_file(path, agent):
    """Map `name.<agent>.ext` to `name.ext` for that agent; None when it belongs to another."""
    parts = path.name.split('.')
    for i, part in enumerate(parts[1:-1], 1):
        if part in AGENTS:
            return path.with_name('.'.join(parts[:i] + parts[i + 1:])) if part == agent else None
    return path


def skill_files(agent):
    files = {}
    for f in sorted(SKILLS.rglob('*')):
        if not f.is_file():
            continue
        target = agent_file(f.relative_to(SKILLS), agent)
        if target is not None and (target not in files or target != f.relative_to(SKILLS)):
            files[target] = f.read_bytes()
    return files


def claude_subagent(source, spec):
    lines = ['---', f'name: {source["name"]}', f'description: {json.dumps(spec["description"])}',
             f'model: {spec["model"]}']
    if 'tools' in spec:
        lines.append(f'tools: {spec["tools"]}')
    return '\n'.join(lines) + f'\n---\n\n{fill(source["prompt"], spec)}'


def codex_subagent(source, spec):
    lines = [f'{key} = {json.dumps(value)}' for key, value in (
        ('name', source['name']), ('description', spec['description']), ('model', spec['model']),
        ('model_reasoning_effort', spec['model_reasoning_effort']))]  # Codex ignores sandbox_mode here
    return '\n'.join(lines) + f'\ndeveloper_instructions = """\n{fill(source["prompt"], spec)}"""\n'


def opencode_subagent(source, spec):
    lines = ['---', f'description: {json.dumps(spec["description"])}', 'mode: subagent', 'permission:']
    lines += [f'  {key}: {value}' for key, value in spec['permission'].items()]
    return '\n'.join(lines) + f'\n---\n\n{fill(source["prompt"], spec)}'


def pi_subagent(source, spec):
    lines = ['---', f'name: {source["name"]}', f'description: {json.dumps(spec["description"])}',
             f'tools: {spec["tools"]}',
             # pi-subagents strips AGENTS.md and the skills catalog from user agents unless asked.
             'inheritProjectContext: true', 'inheritSkills: true']
    return '\n'.join(lines) + f'\n---\n\n{fill(source["prompt"], spec)}'


def copilot_subagent(source, spec):
    lines = ['---', f'name: {source["name"]}', f'description: {json.dumps(spec["description"])}',
             f'tools: {json.dumps(spec["tools"])}']
    return '\n'.join(lines) + f'\n---\n\n{fill(source["prompt"], spec)}'


SUBAGENT_FORMATS = {'claude': ('.claude/agents/{}.md', claude_subagent),
                    'codex': ('.codex/agents/{}.toml', codex_subagent),
                    'opencode': ('.config/opencode/agents/{}.md', opencode_subagent),
                    'pi': ('.pi/agent/agents/{}.md', pi_subagent),
                    'copilot': ('.copilot/agents/{}.agent.md', copilot_subagent)}


def fill(text, spec):
    for key, value in spec.get('vars', {}).items():
        text = text.replace('{{' + key + '}}', value)
    return text


HOOK_CONFIGS = {'claude': '.claude/settings.json', 'codex': '.codex/hooks.json'}
HARNESS_SCRIPTS = {s for scripts in HOOK_SCRIPTS.values() for s in scripts}
SELFTESTED = ('.claude/hooks/harness_guards.py', '.claude/hooks/enforce_memory_graph.py')


def pc_config(home):
    """~/.agent-harness/config.toml: per-PC settings that never go into this repo."""
    config = home / '.agent-harness' / 'config.toml'
    return tomllib.loads(config.read_text(encoding='utf-8')) if config.is_file() else {}


ENGRAM_CLOUD_KEYS = ('ENGRAM_CLOUD_SERVER', 'ENGRAM_CLOUD_AUTOSYNC')


def engram_cloud_env(home):
    """Engram cloud needs the server and autosync in every agent; the token comes from the environment."""
    server = pc_config(home).get('engram_cloud_server')
    return {'ENGRAM_CLOUD_SERVER': server, 'ENGRAM_CLOUD_AUTOSYNC': '1'} if server else {}


def python_for(home):
    """Per-PC interpreter argv: `python` in ~/.agent-harness/config.toml, else py -3 on Windows, else python3."""
    value = pc_config(home).get('python')
    if value:
        return [value.replace('\\', '/')]  # Git Bash eats backslashes
    if os.name == 'nt':  # the launcher survives Python upgrades; python3 there may be the Store stub
        return ['py', '-3'] if shutil.which('py') else [sys.executable.replace('\\', '/')]
    return [shutil.which('python3') or sys.executable]


def hook_key(entry):
    """`script mode` for an entry that runs a harness script; None for anyone else's hook."""
    for hook in entry.get('hooks', []):
        found = re.search(r'/hooks/([\w.]+\.py)["\']?(?:\s+(\S+))?', ' '.join([hook.get('command', ''), *hook.get('args', [])]))
        if found and found[1] in HARNESS_SCRIPTS:
            return f'{found[1]} {found[2] or ""}'.strip()
    return None


def merge_hooks(current, desired):
    """Replace harness entries in place and append missing ones, so other entries keep their index."""
    merged = {}
    for event in [*current, *(e for e in desired if e not in current)]:
        wanted = {hook_key(entry): entry for entry in desired.get(event, [])}
        entries = []
        for entry in current.get(event, []):
            key = hook_key(entry)
            if key is None:
                entries.append(entry)
            elif key in wanted:
                entries.append(wanted.pop(key))
        merged[event] = entries + list(wanted.values())
    return merged


def hook_config(agent, home, standalone=False):
    path = home / HOOK_CONFIGS[agent]
    data = json.loads(path.read_text(encoding='utf-8')) if path.is_file() else {}
    template = (HOOKS / f'{agent}.json').read_text(encoding='utf-8')
    python = python_for(home)
    for key, value in {'python': ' '.join(python),
                       'claude_hooks': (home / ('.codex/hooks' if standalone else '.claude/hooks')).as_posix(),
                       'codex_hooks': (home / '.codex/hooks').as_posix()}.items():
        template = template.replace('{' + key + '}', value)
    desired = json.loads(template)
    for hook in (h for entries in desired.values() for entry in entries for h in entry['hooks']):
        if agent == 'claude':  # exec form: Claude spawns the interpreter itself, with no shell on any OS
            hook['command'], hook['args'] = python[0], python[1:] + hook['args']
        else:  # Codex runs a shell string: sh on POSIX, PowerShell on Windows (which takes cmd-style quotes)
            hook['command'] = (subprocess.list2cmdline if os.name == 'nt' else shlex.join)(python + hook.pop('args'))
    data['hooks'] = merge_hooks(data.get('hooks', {}), desired)
    if agent == 'claude':
        # Subagents may not spawn their own (Claude Code allows 3 levels by default since 2.1.219).
        data.setdefault('env', {})['CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH'] = '1'
        if cloud := engram_cloud_env(home):
            data.setdefault('env', {}).update(cloud)
        else:  # the server was dropped from config.toml: turn the sync off
            for key in ENGRAM_CLOUD_KEYS:
                data.get('env', {}).pop(key, None)
        data.setdefault('enabledPlugins', {}).update(PLUGINS['claude'])
        permissions = data.setdefault('permissions', {})
        for kind in ('deny', 'ask'):
            rules = permissions.setdefault(kind, [])
            rules += [rule for rule in PERMISSIONS['claude'][kind] if rule not in rules]
    return (json.dumps(data, indent=2, ensure_ascii=False) + '\n').encode()


def copilot_hooks(home):
    """Copilot runs `bash` on macOS/Linux and `powershell` on Windows, each one shell string."""
    data = json.loads((HOOKS / 'copilot.json').read_text(encoding='utf-8')
                      .replace('{claude_hooks}', (home / '.claude/hooks').as_posix()))
    shell, join = ('powershell', subprocess.list2cmdline) if os.name == 'nt' else ('bash', shlex.join)
    for entries in data['hooks'].values():
        entries[:] = [{(shell if k == 'args' else k): (join(python_for(home) + v) if k == 'args' else v)
                       for k, v in hook.items()} for hook in entries]
    return (json.dumps(data, indent=2) + '\n').encode()


CODEX_CONFIG = '.codex/config.toml'


def codex_shell_excludes(text):
    """Names in shell_environment_policy.exclude; [] for a missing or malformed value (Codex rejects those)."""
    policy = tomllib.loads(text).get('shell_environment_policy', {})
    exclude = policy.get('exclude', []) if isinstance(policy, dict) else []
    return [n for n in exclude if isinstance(n, str)] if isinstance(exclude, list) else []


def toml_literal(value):
    if isinstance(value, dict):
        return '{' + ', '.join(f'{json.dumps(k)} = {toml_literal(v)}' for k, v in value.items()) + '}'
    if isinstance(value, list):
        return '[' + ', '.join(map(toml_literal, value)) + ']'
    return json.dumps(value, ensure_ascii=False)


def table_value(text, path, key, value):
    """Change one managed TOML assignment, keeping unrelated tables and fields intact."""
    parts = [f'(?:{re.escape(p)}|"{re.escape(p)}"|\'{re.escape(p)}\')' for p in path]
    header = re.search(r'^[ \t]*\[[ \t]*' + r'[ \t]*\.[ \t]*'.join(parts)
                       + r'[ \t]*\][ \t]*(?:#.*)?(?:\n|$)', text, re.M)
    if not header:
        if value is None:
            return text
        # An inline/dotted representation cannot be safely extended as a new table.
        existing = tomllib.loads(text)
        for part in path:
            existing = existing.get(part, {}) if isinstance(existing, dict) else {}
        if existing:
            raise ValueError(f'cannot safely edit inline TOML table {".".join(path)}')
        return text.rstrip('\n') + '\n\n[' + '.'.join(path) + ']\n' + f'{key} = {toml_literal(value)}\n'
    following = re.search(r'^[ \t]*\[[^\n]+\][ \t]*(?:#.*)?$', text[header.end():], re.M)
    end = header.end() + following.start() if following else len(text)
    body = text[header.end():end]
    field = re.search(r'^[ \t]*(?:' + re.escape(key) + '|"' + re.escape(key)
                      + '"|\'' + re.escape(key) + r"')[ \t]*=", body, re.M)
    line = f'{key} = {toml_literal(value)}\n' if value is not None else ''
    if not field:
        return text[:header.end()] + line + text[header.end():]
    statement = ''
    for part in body[field.start():].splitlines(keepends=True):
        statement += part
        try:
            tomllib.loads(statement)
        except ValueError:
            continue  # a multiline array or string is not complete yet
        start = header.end() + field.start()
        return text[:start] + line + text[start + len(statement):]
    raise ValueError(f'cannot parse managed TOML field {key}')


def cli_argv(name, *args):
    """Resolve upstream CLIs, including npm's Windows batch entry points."""
    command = shutil.which(name)
    if not command:
        return None
    if os.name == 'nt' and Path(command).suffix.lower() in ('.cmd', '.bat'):
        return [shutil.which('cmd.exe') or 'cmd.exe', '/d', '/c', command, *args]
    return [command, *args]


def codex_config(home, register=False):
    """Merge managed Codex fields without rewriting unrelated settings."""
    path = home / CODEX_CONFIG
    text = path.read_text(encoding='utf-8') if path.is_file() else ''
    if register:
        for name, args in (('engram', ('mcp', '--tools=agent')), ('codegraph', ('serve', '--mcp'))):
            existing = tomllib.loads(text).get('mcp_servers', {}).get(name)
            if existing is not None:
                command = existing.get('command', '')
                if os.name == 'nt' and '/' in command and command.rsplit('/', 1)[-1].lower() == 'cmd.exe':
                    text = table_value(text, ('mcp_servers', name), 'command', command.replace('/', '\\'))
                continue  # user entries, including disabled/remote ones, stay theirs
            if command := cli_argv(name, *args):
                text = table_value(text, ('mcp_servers', name), 'command', command[0])
                text = table_value(text, ('mcp_servers', name), 'args', command[1:])
    for plugin, enabled in PLUGINS['codex'].items():
        table = re.escape(f'[plugins."{plugin}"]')
        text = re.sub(rf'(^{table}\n(?:(?!\[).*\n)*?)enabled = (?:true|false)\n',
                      rf'\g<1>enabled = {str(enabled).lower()}\n', text, count=1, flags=re.M)
    for key in PERMISSIONS['codex']['remove_env']:  # secrets come from the environment instead
        text = re.sub(rf'^{re.escape(key)}\s*=.*\n', '', text, flags=re.M)
    for server, names in PERMISSIONS['codex']['pass_env'].items():
        entry = tomllib.loads(text).get('mcp_servers', {}).get(server)
        if isinstance(entry, dict) and entry.get('command'):
            # Codex starts stdio MCP servers with a minimal environment; let these through by name.
            current = entry.get('env_vars', [])
            if not isinstance(current, list) or any(not isinstance(v, (str, dict)) for v in current):
                raise ValueError(f'invalid env_vars for MCP server {server}')
            present = {v if isinstance(v, str) else v.get('name') for v in current}
            if missing := [name for name in names if name not in present]:
                text = table_value(text, ('mcp_servers', server), 'env_vars', current + missing)
    # Codex hands its whole environment to shell commands; keep the secrets meant only for MCP servers out.
    secrets = [n for server, names in PERMISSIONS['codex']['pass_env'].items()
               if tomllib.loads(text).get('mcp_servers', {}).get(server, {}).get('command') for n in names]
    current = codex_shell_excludes(text)
    if missing := [n for n in secrets if n not in current]:
        line = f'exclude = {json.dumps(current + missing)}\n'
        header = re.compile(r'^\[shell_environment_policy\][ \t]*(?:#.*)?\n', re.M)
        existing = re.compile(r'(^\[shell_environment_policy\].*\n(?:(?!\[).*\n)*?)'
                              r'exclude\s*=\s*(?:\[[^\]]*\]|[^\n]*)[^\n]*\n', re.M)  # arrays may span lines
        if existing.search(text):
            candidate = existing.sub(lambda m: m[1] + line, text, count=1)
        elif found := header.search(text):
            candidate = text[:found.end()] + line + text[found.end():]
        else:
            candidate = text.rstrip('\n') + '\n\n[shell_environment_policy]\n' + line
        try:
            if set(secrets) <= set(codex_shell_excludes(candidate)):
                text = candidate
        except ValueError:
            pass  # a layout this cannot edit (dotted keys, inline table): doctor reports it
    cloud = engram_cloud_env(home)
    if tomllib.loads(text).get('mcp_servers', {}).get('engram', {}).get('command'):
        for key in ENGRAM_CLOUD_KEYS:
            text = table_value(text, ('mcp_servers', 'engram', 'env'), key, cloud.get(key))
    tomllib.loads(text)  # never write a config Codex could not read
    return text.encode()


PI_SETTINGS = '.pi/agent/settings.json'


def pi_settings(home):
    """Drop the ~/.claude/skills entry earlier installs added: Pi reads ~/.agents/skills itself. Keep everything else."""
    data = json.loads((home / PI_SETTINGS).read_text(encoding='utf-8'))
    if isinstance(data.get('skills'), list) and '~/.claude/skills' in data['skills']:
        data['skills'].remove('~/.claude/skills')
    return (json.dumps(data, indent=2, ensure_ascii=False) + '\n').encode()


COPILOT_MCP = '.copilot/mcp-config.json'


def copilot_mcp(home):
    """Add Engram to Copilot's MCP servers when it is missing; None when there is nothing to add."""
    path, engram = home / COPILOT_MCP, shutil.which('engram')
    data = json.loads(path.read_text(encoding='utf-8')) if path.is_file() else {}
    servers = data.setdefault('mcpServers', {})
    if 'engram' in servers or not engram:
        return None  # an entry of the user's own stays as written
    servers['engram'] = {'type': 'local', 'command': engram, 'args': ['mcp', '--tools=agent'], 'tools': ['*']}
    return (json.dumps(data, indent=2, ensure_ascii=False) + '\n').encode()


OPENCODE_CONFIG = '.config/opencode/opencode.json'


def opencode_config(home):
    """Add the harness approval prompts and let the orchestrator call the harness subagents."""
    data = json.loads((home / OPENCODE_CONFIG).read_text(encoding='utf-8'))
    permission = data.setdefault('permission', {})
    if isinstance(permission, dict):
        bash = permission.setdefault('bash', {})
        if isinstance(bash, dict):
            for pattern in PERMISSIONS['opencode']['ask']:
                bash.setdefault(pattern, 'ask')
    task = data.get('agent', {}).get('orchestrator', {}).get('permission', {}).get('task')
    if isinstance(task, dict):
        for f in sorted(SUBAGENTS.glob('*.toml')):
            task.setdefault(f.stem, 'allow')
    return (json.dumps(data, indent=2, ensure_ascii=False) + '\n').encode()


# VS Code's user profile on macOS, Linux, and Windows.
VSCODE_USER = ('Library/Application Support/Code/User', '.config/Code/User', 'AppData/Roaming/Code/User')


def vscode_user(home):
    return next((rel for rel in VSCODE_USER if (home / rel).is_dir()), None)


RULES = '.codex/rules/default.rules'
RULES_BEGIN = '# >>> agent-harness: managed by bin/harness, edit core/hooks/codex.rules\n'
RULES_END = '# <<< agent-harness\n'


def codex_rules(home):
    """Keep the harness rules in one marked block; leave rules Codex added on its own alone."""
    path = home / RULES
    current = path.read_text(encoding='utf-8') if path.is_file() else ''
    block = (HOOKS / 'codex.rules').read_text(encoding='utf-8')
    if RULES_BEGIN in current and RULES_END in current:
        before, rest = current.split(RULES_BEGIN, 1)
        after = rest.split(RULES_END, 1)[1]
    else:  # first install: drop unmarked copies of harness lines left by earlier hand edits
        ours = {line for line in block.splitlines() if line.strip()}
        before = ''.join(l for l in current.splitlines(True) if l.rstrip('\n') not in ours).rstrip('\n')
        before, after = (before + '\n\n' if before else ''), ''
    return (before + RULES_BEGIN + block + RULES_END + after).encode()


# Optional agents get files only on PCs that have them; Claude and Codex are always managed.
OPTIONAL_AGENTS = {'opencode': '.config/opencode', 'pi': '.pi/agent', 'copilot': '.copilot'}


def present(agent, home):
    return agent not in OPTIONAL_AGENTS or (home / OPTIONAL_AGENTS[agent]).is_dir()


# Which agents need each path, first match wins. Shared files go with every agent that reads them:
# all guards run from ~/.claude/hooks, and all but Claude read the skills in ~/.agents/skills.
OWNERS = (('.claude/hooks/', set(AGENTS)), ('.agents/', set(AGENTS) - {'claude'}), ('.claude/', {'claude'}),
          ('.codex/', {'codex'}), ('.config/opencode/', {'opencode'}), ('.pi/', {'pi'}), ('.copilot/', {'copilot'}),
          ('.config/copilot/', {'copilot'}), *((f'{user}/', {'copilot'}) for user in VSCODE_USER))


def wanted(rel, agents):
    return bool(next(owners for prefix, owners in OWNERS if rel.startswith(prefix)) & agents)


def choice_file(home):
    return home / '.agent-harness' / 'agents'


def saved_choice(home):
    """Agents saved on this PC; empty when there is no usable choice."""
    if not choice_file(home).is_file():
        return set()
    return set(choice_file(home).read_text(encoding='utf-8', errors='replace').split()) & set(AGENTS)


def selected(home):
    """The agents chosen on this PC; with no choice saved, every agent `present` finds."""
    return saved_choice(home) or {agent for agent in AGENTS if present(agent, home)}


def retiring(home, agents=None):
    """Old copies to clear. With no choice made, all of them; otherwise only the chosen agents' own."""
    if agents is None and not saved_choice(home):
        return RETIRED
    chosen = selected(home) if agents is None else agents
    return [rel for rel in RETIRED if wanted(rel, chosen)]


def detected(home):
    """Agents with their own config or a command on this PC."""
    # Not ~/.claude for Claude Code: `install` creates it for the hooks every agent shares.
    marks = {**OPTIONAL_AGENTS, 'claude': '.claude.json', 'codex': '.codex'}
    found = {agent for agent in AGENTS if (home / marks[agent]).exists() or shutil.which(agent)}
    return found | {'copilot'} if vscode_user(home) else found


def label(agent):
    return AGENTS[agent]['vars']['agent']


def where(agent):
    return f'~/{Path(AGENTS[agent]["path"]).parent.as_posix()}'


KEEP_NOTE = 'Unticked agents keep their files.'


def pick_curses(names, ticked, missing):
    os.environ.setdefault('ESCDELAY', '25')  # curses waits a full second to tell Esc from an arrow key otherwise
    width = max(len(label(name)) for name in names)

    def screen_loop(screen):
        curses.curs_set(0)
        at, chosen, note = 0, set(ticked), ''
        while True:
            rows = [f'{">" if i == at else " "} [{"x" if name in chosen else " "}] {label(name):<{width}}  {where(name)}'
                    for i, name in enumerate(names)]
            footer = [f'Not found: {", ".join(missing)}'] if missing else []
            screen.erase()
            for y, line in enumerate(['agent-harness: where to install', '', *rows, '', *footer, KEEP_NOTE,
                                      note or 'Up/Down move, Space ticks, Enter installs, q cancels']):
                screen.addnstr(y, 0, line, curses.COLS - 1)
            key, note = screen.getch(), ''
            if key in (curses.KEY_UP, ord('k')):
                at = (at - 1) % len(names)
            elif key in (curses.KEY_DOWN, ord('j')):
                at = (at + 1) % len(names)
            elif key == ord(' '):
                chosen ^= {names[at]}
            elif key in (10, 13, curses.KEY_ENTER):
                if chosen:
                    return chosen
                note = 'Tick at least one agent, or press q to cancel'
            elif key in (ord('q'), 27):
                return None
    return curses.wrapper(screen_loop)


def pick_text(names, ticked, missing):
    for i, name in enumerate(names, 1):
        print(f'  {i}. [{"x" if name in ticked else " "}] {label(name)}  {where(name)}')
    if missing:
        print(f'Not found: {", ".join(missing)}')
    print(KEEP_NOTE)
    default = ','.join(str(i) for i, name in enumerate(names, 1) if name in ticked)
    while True:
        answer = input(f'Numbers or names to install [{default}], q cancels: ').strip().lower()
        if answer == 'q':
            return None
        words = re.findall(r'[\w-]+', answer or default)
        picked = {names[int(w) - 1] if w.isdigit() and 0 < int(w) <= len(names) else w for w in words}
        if words and picked <= set(names):
            return picked
        print(f'not an agent here: {answer or "(none)"}; use the numbers or names above')


def choose_agents(home):
    """Ask where to install; an empty result means nothing was picked."""
    found = detected(home)
    names = [agent for agent in AGENTS if agent in found]
    if not names:
        print('no supported agent found on this PC')
        return None
    missing = [label(agent) for agent in AGENTS if agent not in found]
    ticked = saved_choice(home) & found or set(names)
    try:
        if curses and sys.stdin.isatty() and sys.stdout.isatty():
            try:
                return pick_curses(names, ticked, missing)
            except curses.error:  # unknown TERM or a window too small to draw
                pass
        return pick_text(names, ticked, missing)
    except (KeyboardInterrupt, EOFError):
        return None


def outputs(home, agent=None, agents=None):
    """Every file the harness manages for these agents, as home-relative path -> bytes.

    `agent` is the standalone mode: that agent alone, with its own hook copies."""
    standalone = agent == 'codex'
    agents = {agent} if agent else selected(home) if agents is None else agents
    files = {}
    for name, spec in AGENTS.items():
        if name in agents:
            files[spec['path']] = render(name).encode()
        for rel, data in skill_files(name).items() if spec['skills'] else ():
            files[f'{spec["skills"]}/{rel}'] = data
    for folder, scripts in HOOK_SCRIPTS.items():
        if standalone:
            if folder != '.codex/hooks':
                continue
            scripts = HOOK_SCRIPTS['.claude/hooks']
        for script in scripts:
            files[f'{folder}/{script}'] = (HOOKS / script).read_bytes()
    if 'codex' in agents:
        files[RULES] = codex_rules(home)
    user = vscode_user(home)
    if 'copilot' in agents and user:  # VS Code's local chat reads profile prompts, not ~/.copilot
        header = "---\napplyTo: '**'\ndescription: agent-harness rules (edit the agent-harness repo)\n---\n\n"
        files[f'{user}/prompts/agent-harness.instructions.md'] = (header + render('copilot')).encode()
    if 'pi' in agents and (home / PI_SETTINGS).is_file():
        try:
            files[PI_SETTINGS] = pi_settings(home)
        except ValueError:
            pass  # unparseable config: `check` reports it as invalid
    if 'opencode' in agents and (home / OPENCODE_CONFIG).is_file():
        try:
            files[OPENCODE_CONFIG] = opencode_config(home)
        except ValueError:
            pass  # unparseable config: `check` reports it as invalid
    if standalone or ('codex' in agents and (home / CODEX_CONFIG).is_file()):
        try:
            files[CODEX_CONFIG] = codex_config(home, register=standalone)
        except ValueError:
            pass  # unparseable config: `check` reports it as invalid
    for agent, rel in HOOK_CONFIGS.items():
        if agent not in agents:
            continue
        try:
            files[rel] = hook_config(agent, home, standalone=standalone)
        except ValueError:
            pass  # unparseable config: never overwrite it; `check` reports it as invalid
    for f in sorted(SUBAGENTS.glob('*.toml')):
        source = tomllib.loads(f.read_text(encoding='utf-8'))
        for agent, (path, fmt) in SUBAGENT_FORMATS.items():
            if agent in agents:
                files[path.format(source['name'])] = fmt(source, source[agent]).encode()
    for agent, source, target in (('opencode', 'opencode/agent-harness.ts', '.config/opencode/plugins/agent-harness.ts'),
                                  ('pi', 'pi/agent-harness.ts', '.pi/agent/extensions/agent-harness.ts')):
        if agent in agents:
            guard = (REPO / 'core' / source).read_text(encoding='utf-8')
            guard = guard.replace('{python}', json.dumps(python_for(home))).replace('{claude_hooks}', (home / '.claude/hooks').as_posix())
            files[target] = guard.encode()
    if 'copilot' in agents:
        files['.copilot/hooks/agent-harness.json'] = copilot_hooks(home)
        try:
            if mcp := copilot_mcp(home):
                files[COPILOT_MCP] = mcp
        except ValueError:
            pass  # unparseable config: `check` reports it as invalid
    return {rel: data for rel, data in files.items() if wanted(rel, agents)}


def engram_mcp_commands(home):
    """`claude mcp` argvs that register the Engram MCP when none reaches Claude Code: its plugin stopped shipping
    one in 0.1.16. An entry with no command or url starts nothing, so it is removed first; `add` refuses a taken name."""
    installed, state = home / '.claude/plugins/installed_plugins.json', home / '.claude.json'
    engram = shutil.which('engram')
    try:
        plugin = (json.loads(installed.read_text(encoding='utf-8')).get('plugins', {}).get('engram@engram') or [{}])[0]
        servers = json.loads(state.read_text(encoding='utf-8')).get('mcpServers') or {} if state.is_file() else {}
    except (OSError, ValueError):
        return None  # no plugin, or Claude is rewriting its own state file: leave it alone
    if not engram or not plugin.get('installPath') or (Path(plugin['installPath']) / '.mcp.json').is_file() \
            or isinstance(entry := servers.get('engram'), dict) and (entry.get('command') or entry.get('url')):
        return None
    add = ['claude', 'mcp', 'add', '--transport', 'stdio', '--scope', 'user', 'engram', '--', engram, 'mcp', '--tools=agent']
    return [add] if entry is None else [['claude', 'mcp', 'remove', '--scope', 'user', 'engram'], add]


RETIRED = [line.strip() for line in (REPO / 'core' / 'retired.txt').read_text(encoding='utf-8').splitlines()
           if line.strip() and not line.startswith('#')]
# Codex skills moved to ~/.agents/skills; the old ~/.codex/skills copies would load twice.
RETIRED += [f'.codex/skills/{d.name}' for d in sorted(SKILLS.iterdir()) if d.is_dir()]


def backup_stamp():
    return datetime.now().strftime('%Y%m%d-%H%M%S-%f')  # microseconds: two runs can share a second


def install(home, dry_run=False, agent=None, agents=None):
    changed = False
    chosen = {agent} if agent else selected(home) if agents is None else agents
    backup_dir = home / '.agent-harness' / 'backups' / backup_stamp()
    manifest = {'created': [], 'replaced': [], 'retired': []}

    def record(kind, rel):  # written as it goes, so a failed install can still be restored
        manifest[kind].append(rel)
        backup_dir.mkdir(parents=True, exist_ok=True)
        (backup_dir / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n', encoding='utf-8')

    for rel in retiring(home, {agent} if agent else agents):
        stale = home / rel
        if stale.exists():
            changed = True
            if dry_run:
                print(f'would retire {stale}')
                continue
            (backup_dir / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(stale), str(backup_dir / rel))
            record('retired', rel)
            print(f'retired {stale} -> {backup_dir / rel}')
    for rel, content in outputs(home, agent, agents).items():
        target = home / rel
        if target.is_file() and target.read_bytes() == content:
            continue
        if dry_run:
            print(f'would install {target}')
            changed = True
            continue
        if target.is_file():
            saved = backup_dir / rel
            saved.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(target, saved)
            record('replaced', rel)
            print(f'backed up {target} -> {saved}')
        else:
            record('created', rel)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(content)
        print(f'installed {target}')
        if rel == HOOK_CONFIGS['codex']:
            print('Codex skips a changed hook until you trust it again in /hooks')
        changed = True
    if 'claude' in chosen and (commands := engram_mcp_commands(home)):  # Claude owns ~/.claude.json, so its CLI writes the entry
        changed = True
        claude = shutil.which('claude')
        if dry_run:
            print('would register the Engram MCP for Claude Code')
        elif not claude:
            print(f'register the Engram MCP for Claude Code: {" && ".join(map(shlex.join, commands))}')
        else:
            saved = backup_dir / '.claude.json'
            if (home / '.claude.json').is_file():
                saved.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(home / '.claude.json', saved)
                print(f'backed up {home / ".claude.json"} -> {saved}')
            for command in commands:
                result = subprocess.run([claude, *command[1:]], capture_output=True, encoding='utf-8', errors='replace',
                                        timeout=60, env={**os.environ, 'HOME': str(home), 'USERPROFILE': str(home)})
                if result.returncode:
                    break
            print('registered the Engram MCP for Claude Code; restart it' if result.returncode == 0
                  else f'could not register the Engram MCP: {result.stderr.strip() or result.stdout.strip()}')
    if agents is not None and not dry_run:
        choice_file(home).parent.mkdir(parents=True, exist_ok=True)
        choice_file(home).write_text('\n'.join(sorted(agents)) + '\n', encoding='utf-8', newline='\n')
    if not changed:
        print('no changes')


def restore(home, stamp):
    """Undo one install. What it takes away moves to a `-before-restore` folder; nothing is deleted."""
    backups = home / '.agent-harness' / 'backups'
    source = backups / stamp
    if Path(stamp).name != stamp or not (source / 'manifest.json').is_file():
        print(f'no install manifest in {source}; restore older backups by hand')
        return 1
    manifest = json.loads((source / 'manifest.json').read_text(encoding='utf-8'))
    if missing := [rel for rel in manifest['replaced'] + manifest['retired'] if not os.path.lexists(source / rel)]:
        print(f'{source} is incomplete, nothing changed; missing: {", ".join(missing)}')
        return 1
    kept = backups / f'{backup_stamp()}-before-restore'
    for rel in manifest['created'] + manifest['retired']:
        target = home / rel
        if os.path.lexists(target):
            (kept / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(target), str(kept / rel))
            print(f'kept {target} -> {kept / rel}')
    for rel in manifest['retired']:
        saved, target = source / rel, home / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        if saved.is_symlink():
            target.symlink_to(os.readlink(saved))
        elif saved.is_dir():
            shutil.copytree(saved, target, symlinks=True)
        else:
            shutil.copy2(saved, target)
        print(f'restored {target}')
    for rel in manifest['replaced']:  # copied over, not moved: a symlinked dotfile stays a link
        saved, target = source / rel, home / rel
        if target.is_file():
            (kept / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(target, kept / rel)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(saved, target)
        print(f'restored {target}')
    return 0


SECRET_NAME = re.compile(r'token|secret|password|api_?key', re.I)
NOT_SECRET = re.compile(r'tokens$|_env_var$', re.I)  # token counts, names of env vars


def literal_secrets(data, prefix=''):
    """Dotted names of secret-looking keys holding a literal value (the value is never returned)."""
    for key, value in data.items():
        name = f'{prefix}{key}'
        if isinstance(value, dict):
            yield from literal_secrets(value, name + '.')
        elif isinstance(value, str) and value and SECRET_NAME.search(key) and not NOT_SECRET.search(key):
            yield name


def check(home, agent=None, runtime=False):
    problems = []
    for rel, content in outputs(home, agent).items():
        target = home / rel
        if not target.is_file() or target.read_bytes() != content:
            problems.append(f'drift: {target}')
    problems += [f'stale: {home / rel}' for rel in retiring(home, {agent} if agent else None) if (home / rel).exists()]
    agents = {agent} if agent else selected(home)
    selftested = [rel.replace('.claude/', '.codex/') for rel in SELFTESTED] if agent else SELFTESTED
    for rel in selftested:
        script = home / rel
        if script.is_file():
            result = subprocess.run([*python_for(home), str(script), 'selftest'],
                                    capture_output=True, encoding='utf-8', errors='replace', timeout=60)
            if result.returncode != 0:
                problems.append(f'selftest failed: {script}')
    for rel, parse in CONFIGS.items():
        path = home / rel
        if wanted(rel, agents) and path.is_file():
            try:
                data = parse(path.read_text(encoding='utf-8'))
            except ValueError as error:  # JSONDecodeError and TOMLDecodeError are ValueErrors
                problems.append(f'invalid: {path}: {error}')
                continue
            scope = {'env': data.get('env', {})} if rel.endswith('settings.json') else data
            problems += [f'secret: {path}: {key}' for key in literal_secrets(scope)]
    if runtime:
        problems += codex_runtime_findings(home)
    for problem in problems:
        print(problem)
    print('ok' if not problems else f'{len(problems)} problem(s); install fixes drift; /hooks reviews hook trust')
    return 1 if problems else 0


# Claude Code's own skills; overrides for them are never orphans. New built-ins need adding here.
BUILTIN_SKILLS = {'init', 'review', 'security-review', 'simplify', 'loop', 'schedule', 'claude-api',
                  'update-config', 'keybindings-help', 'fewer-permission-prompts'}


def installed_skill_names(home):
    names = {d.name for d in (home / '.claude/skills').glob('*') if d.is_dir()}
    cache = home / '.claude/plugins/cache'
    for skill in [*cache.glob('*/*/*/skills/*'), *cache.glob('*/*/*/commands/*.md')]:
        plugin, name = skill.parents[2].name, skill.stem  # plugin commands act as skills too
        names |= {name, f'{plugin}:{name}'}
    return names | BUILTIN_SKILLS


ENGRAM_RELEASE = 'https://api.github.com/repos/Gentleman-Programming/engram/releases/latest'


def engram_versions(home):
    claude = codex = None
    installed = home / '.claude/plugins/installed_plugins.json'
    if installed.is_file():
        entries = json.loads(installed.read_text(encoding='utf-8')).get('plugins', {}).get('engram@engram') or [{}]
        claude = entries[0].get('version')
    cached = sorted(d.name for d in (home / '.codex/plugins/cache/engram/engram').glob('*') if d.is_dir())
    codex = cached[-1] if cached else None
    binary = update = None
    if shutil.which('engram'):
        out = subprocess.run(['engram', 'version'], capture_output=True, encoding='utf-8', errors='replace', timeout=30)
        binary = (re.search(r'engram v?(\d\S*)', out.stdout) or [None, None])[1]
    if binary:  # engram prints its own update notice only to a terminal, and the brew tap can lag the release
        try:
            with urllib.request.urlopen(ENGRAM_RELEASE, timeout=5) as response:
                latest = json.load(response)['tag_name'].lstrip('v')
            update = f'{binary} -> {latest}' if latest != binary else None
        except (OSError, http.client.HTTPException, ValueError, KeyError, TypeError, AttributeError):  # best effort
            pass
    return binary, claude, codex, update


def codegraph_update():
    """`installed -> latest` when npm offers a newer CodeGraph; its release notes ask for a re-index after upgrading."""
    codegraph, npm = shutil.which('codegraph'), shutil.which('npm')
    if not (codegraph and npm):
        return None
    try:
        installed = subprocess.run([codegraph, '--version'], capture_output=True, encoding='utf-8', errors='replace',
                                   timeout=30).stdout.strip()
        latest = subprocess.run([npm, 'view', '@colbymchenry/codegraph', 'version'], capture_output=True,
                                encoding='utf-8', errors='replace', timeout=60).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    version = lambda text: tuple(map(int, text.split('.'))) if re.fullmatch(r'\d+\.\d+\.\d+', text) else None
    if version(installed) and version(latest) and version(installed) < version(latest):
        return f'{installed} -> {latest}'
    return None


def marketplace_version(manifest):
    """Engram plugin version a marketplace manifest offers (Claude lists plugins; Codex has one)."""
    if not manifest.is_file():
        return None
    try:
        data = json.loads(manifest.read_text(encoding='utf-8'))
    except ValueError:
        return None
    for plugin in data.get('plugins', [data]):
        if plugin.get('name', 'engram') == 'engram':
            return plugin.get('version')
    return None


def query_codex_hooks(home, command=None, timeout=12):
    """Read effective hooks through Codex's local API. Never start turns or change trust."""
    command = command or cli_argv('codex', 'app-server', '--stdio')
    if not command:
        raise FileNotFoundError('Codex CLI unavailable')
    env = {**os.environ, 'CODEX_HOME': str((home / '.codex').resolve()),
           'HOME': str(home), 'USERPROFILE': str(home)}
    process = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, text=True, encoding='utf-8', errors='replace', env=env)
    replies = queue.Queue(maxsize=1)

    def exchange():
        try:
            consumed = 0
            def send(message):
                process.stdin.write(json.dumps(message) + '\n')
                process.stdin.flush()
            def receive(identifier):
                nonlocal consumed
                while True:
                    line = process.stdout.readline(65537)
                    consumed += len(line)
                    if not line or len(line) > 65536 or consumed > 1048576:
                        raise RuntimeError('Codex hook API returned no bounded response')
                    response = json.loads(line)
                    if response.get('id') == identifier:
                        if 'error' in response:
                            raise RuntimeError('Codex hook API rejected the request')
                        return response['result']
            send({'id': 0, 'method': 'initialize', 'params': {
                'clientInfo': {'name': 'agent_harness', 'version': '0.1'}}})
            receive(0)
            send({'method': 'initialized'})
            send({'id': 1, 'method': 'hooks/list', 'params': {'cwds': [str(Path.cwd())]}})
            replies.put((True, receive(1)))
        except Exception as error:
            replies.put((False, error))

    worker = threading.Thread(target=exchange, daemon=True)
    worker.start()
    try:
        try:
            success, result = replies.get(timeout=timeout)
        except queue.Empty:
            raise TimeoutError('Codex hook API timed out') from None
        if not success:
            raise RuntimeError('Codex hook API could not be verified') from None
        return result
    finally:
        try:
            process.stdin.close()
        except BrokenPipeError:
            pass  # the server may have already exited
        try:
            process.wait(timeout=1)
        except subprocess.TimeoutExpired:
            if os.name == 'nt':
                subprocess.run(['taskkill', '/PID', str(process.pid), '/T', '/F'],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
            if process.poll() is None:
                process.kill()
            process.wait(timeout=5)
        worker.join(timeout=1)
        process.stdout.close()


def codex_hook_findings(expected, source, metadata):
    """Assess Codex's effective hook metadata, not a guessed trust hash."""
    findings = []
    normalized = lambda path: os.path.normcase(str(Path(path).resolve()))
    for event, entries in expected.items():
        for entry in entries:
            for handler in entry['hooks']:
                label = f'{event} {entry.get("matcher", "*")}'
                matched = [hook for hook in metadata
                           if normalized(hook.get('sourcePath', '')) == normalized(source)
                           and str(hook.get('eventName', '')).lower() == event.lower()
                           and hook.get('matcher') == entry.get('matcher')
                           and hook.get('command') == handler.get('command')]
                if not matched:
                    findings.append(f'Codex hook missing: {label}')
                elif not any(hook.get('enabled') and hook.get('trustStatus') in ('trusted', 'managed')
                             for hook in matched):
                    state = 'disabled' if not any(hook.get('enabled') for hook in matched) else \
                        ','.join(sorted({hook.get('trustStatus') or 'unverified' for hook in matched}))
                    findings.append(f'Codex hook {state}: {label}; review it in /hooks')
    return findings


def codex_runtime_findings(home):
    findings = []
    config, hooks = home / CODEX_CONFIG, home / HOOK_CONFIGS['codex']
    try:
        data = tomllib.loads(config.read_text(encoding='utf-8')) if config.is_file() else {}
        for name in ('engram', 'codegraph'):
            entry = data.get('mcp_servers', {}).get(name, {})
            if not (entry.get('command') or entry.get('url')):
                findings.append(f'Codex MCP missing: {name}; install its CLI and run install --agent codex')
            elif entry.get('enabled') is False:
                findings.append(f'Codex MCP disabled: {name}; review your existing server entry')
            elif entry.get('command') and not shutil.which(entry['command']):
                findings.append(f'Codex MCP command unavailable: {name}')
            elif str(entry.get('command', '')).replace('\\', '/').rsplit('/', 1)[-1].lower() in ('cmd', 'cmd.exe'):
                args = entry.get('args', [])
                if len(args) >= 3 and [arg.lower() for arg in args[:2]] == ['/d', '/c'] \
                        and not shutil.which(args[2]):
                    findings.append(f'Codex MCP launcher unavailable: {name}')
        engram = data.get('mcp_servers', {}).get('engram', {})
        if engram.get('command'):
            names = engram.get('env_vars', [])
            if not any(v == 'ENGRAM_CLOUD_TOKEN' or isinstance(v, dict) and v.get('name') == 'ENGRAM_CLOUD_TOKEN'
                       for v in names):
                findings.append('Codex Engram token forwarding missing: env_vars must name ENGRAM_CLOUD_TOKEN')
            if 'ENGRAM_CLOUD_TOKEN' not in codex_shell_excludes(config.read_text(encoding='utf-8')):
                findings.append('Codex shell token exclusion missing: ENGRAM_CLOUD_TOKEN')
        probe = subprocess.run([*python_for(home), '-c',
            'import importlib.util,json; print(json.dumps({"zstd": importlib.util.find_spec("compression") is not None and importlib.util.find_spec("compression.zstd") is not None}))'],
            capture_output=True, encoding='utf-8', errors='replace', timeout=5)
        if probe.returncode:
            findings.append('Codex hook Python unavailable; configure python in ~/.agent-harness/config.toml')
        elif not json.loads(probe.stdout).get('zstd') and any((home / '.codex/sessions').rglob('*.jsonl.zst')):
            findings.append('Codex compressed transcript checks unavailable; configure Python 3.14 or newer')
    except (OSError, ValueError, TypeError, AttributeError, subprocess.SubprocessError):
        findings.append('Codex configuration or hook Python could not be verified; inspect config and interpreter')
    findings += untrusted_codex_hooks(home)
    return findings


def untrusted_codex_hooks(home):
    """Effective hook readiness from Codex, including modified/disabled/unknown states."""
    hooks = home / HOOK_CONFIGS['codex']
    if not hooks.is_file():
        return []  # structural check reports the missing file
    findings = []
    try:
        installed = json.loads(hooks.read_text(encoding='utf-8')).get('hooks', {})
        expected = {event: [entry for entry in entries if hook_key(entry)] for event, entries in installed.items()}
        reported = query_codex_hooks(home)
        items = reported.get('data')
        if not isinstance(items, list) or not items:
            raise ValueError('missing hook API data')
        if any(item.get('warnings') or item.get('errors') for item in items):
            findings.append('Codex hook loading reported warnings/errors; inspect /hooks')
        metadata = [hook for item in items for hook in item.get('hooks', [])]
        findings += codex_hook_findings(expected, str(hooks), metadata)
    except (OSError, ValueError, TypeError, AttributeError, RuntimeError, subprocess.SubprocessError):
        findings.append('Codex hook state unverified; check the local Codex CLI and inspect /hooks')
    return findings


def doctor(home, agent=None):
    """Report leftovers and version drift; never changes anything."""
    if agent == 'codex':
        return check(home, agent, runtime=True)
    findings = []
    agents = selected(home)
    settings = home / '.claude/settings.json'
    if settings.is_file():
        overrides = json.loads(settings.read_text(encoding='utf-8')).get('skillOverrides', {})
        known = installed_skill_names(home)
        findings += [f'orphan skill override: {name} (remove it from skillOverrides in {settings})'
                     for name in overrides if name not in known]
    vscode = home / (vscode_user(home) or VSCODE_USER[0]) / 'settings.json'
    if vscode.is_file():  # JSONC with comments: read the one setting with a regex, never rewrite it
        block = re.search(r'"github\.copilot\.chat\.instructions"\s*:\s*\[(.*?)\]', vscode.read_text(encoding='utf-8'), re.S)
        for path in re.findall(r'~/[^\s",]+', block[1] if block else ''):
            if not (home / path[2:]).exists():
                findings.append(f'github.copilot.chat.instructions points to a missing file: {path} '
                                f'(remove that entry from {vscode})')
    seen, duplicates = set(), []
    for entry in os.environ.get('PATH', '').split(os.pathsep):
        if entry in seen and entry not in duplicates:
            duplicates.append(entry)
        seen.add(entry)
    findings += [f'duplicate PATH entry: {entry} (added twice by your shell startup files)'
                 for entry in duplicates]
    binary, claude, codex, update = engram_versions(home)
    print(f'engram: binary {binary or "not found"}, claude plugin {claude or "-"}, codex plugin {codex or "-"}')
    # Claude and Codex ship separate Engram plugins; compare each with its own marketplace.
    for agent, installed, latest, fix in (
            ('claude', claude, marketplace_version(home / '.claude/plugins/marketplaces/engram/.claude-plugin/marketplace.json'),
             'claude plugin update engram@engram'),
            ('codex', codex, marketplace_version(home / '.codex/.tmp/marketplaces/engram/plugin/codex/.codex-plugin/plugin.json'),
             'codex plugin marketplace upgrade engram && codex plugin add engram@engram')):
        if installed and latest and installed != latest:
            findings.append(f'engram {agent} plugin outdated: {installed} -> {latest} ({fix})')
    if claude := shutil.which('claude'):  # the terminal CLI; the desktop apps update their own copy
        try:
            out = subprocess.run([claude, '--version'], capture_output=True, encoding='utf-8', errors='replace',
                                 timeout=30).stdout
        except (OSError, subprocess.SubprocessError):
            out = ''
        if (found := re.match(r'\s*(\d+)\.(\d+)\.(\d+)', out)) and tuple(map(int, found.groups())) < (2, 1, 319):
            findings.append(f'claude code {".".join(found.groups())} can let actions past the guards: before 2.1.319 '
                            'an env-prefixed Bash command could bypass permissions and a new worktree could escape the '
                            'sandbox; older versions also skip Bash hooks for Monitor or let a failing guard through '
                            '(claude update)')
    codex = home / CODEX_CONFIG
    try:
        exposed = 'codex' in agents and codex.is_file() and 'engram' in tomllib.loads(codex.read_text(encoding='utf-8')).get('mcp_servers', {}) \
            and 'ENGRAM_CLOUD_TOKEN' not in codex_shell_excludes(codex.read_text(encoding='utf-8'))
    except ValueError:
        exposed = False  # unparseable: `check` reports it
    if exposed:
        findings.append(f'Codex shell commands inherit ENGRAM_CLOUD_TOKEN: add it to '
                        f'shell_environment_policy.exclude in {codex}')
    if 'claude' in agents and (commands := engram_mcp_commands(home)):
        problem = 'is not registered for Claude Code' if len(commands) == 1 else 'for Claude Code has no command'
        findings.append(f'engram MCP {problem}, so its mem_* tools are missing '
                        '(run `bin/harness install` and restart Claude Code)')
    if 'codex' in agents:
        findings += untrusted_codex_hooks(home)
    if cg_update := codegraph_update():
        findings.append(f'codegraph update available: {cg_update} (npm install -g @colbymchenry/codegraph, '
                        'then `codegraph index` in each indexed repo)')
    if update:
        findings.append(f'engram update available: {update} (brew upgrade engram)')
    pi = home / PI_SETTINGS  # Engram 3.7.0 pairs with gentle-engram 0.7.0; Pi keeps the version setup pinned
    if 'pi' in agents and binary and pi.is_file() and (found := re.match(r'(\d+)\.(\d+)', binary)) \
            and tuple(map(int, found.groups())) >= (3, 7) \
            and (pinned := re.search(r'npm:gentle-engram@((\d+)\.(\d+)\S*?)"', pi.read_text(encoding='utf-8'))) \
            and (int(pinned[2]), int(pinned[3])) < (0, 7):
        findings.append(f'Pi pins gentle-engram@{pinned[1]}, older than Engram {binary} expects '
                        '(engram setup pi, then restart Pi)')
    if engram := shutil.which('engram'):  # the status names where the token came from, never its value
        try:
            status = subprocess.run([engram, 'cloud', 'status'], capture_output=True, encoding='utf-8',
                                    errors='replace', timeout=30).stdout
        except (OSError, subprocess.SubprocessError):
            status = ''
        field = lambda name: (re.search(rf'^{name}: (.+)$', status, re.M) or [None, '-'])[1]
        auth = field('Auth status').split(' ')[0]
        print(f'engram cloud: {field("Cloud status")}, server {field("Server")}, auth {auth}')
        if engram_cloud_env(home) and auth != 'ready':
            findings.append('engram cloud is not ready: set ENGRAM_CLOUD_TOKEN for your user '
                            '(README, "Engram cloud token") and restart the agents')
    for finding in findings:
        print(finding)
    if not findings:
        print('no findings')
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog='harness')
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('render').add_argument('agent', choices=AGENTS)
    inst = sub.add_parser('install')
    inst.add_argument('--home', type=Path, default=Path.home())
    inst.add_argument('--dry-run', action='store_true')
    pick = inst.add_mutually_exclusive_group()
    pick.add_argument('--agent', choices=['codex'], help='Codex alone, with its own hook copies')
    pick.add_argument('--agents', help=f'comma-separated: {",".join(AGENTS)}')
    pick.add_argument('--choose', action='store_true', help='pick the agents again')
    back = sub.add_parser('restore')
    back.add_argument('stamp')
    back.add_argument('--home', type=Path, default=Path.home())
    checking = sub.add_parser('check')
    checking.add_argument('--home', type=Path, default=Path.home())
    checking.add_argument('--agent', choices=['codex'])
    checking.add_argument('--runtime', action='store_true', help='verify effective Codex hooks and integrations')
    diagnosing = sub.add_parser('doctor')
    diagnosing.add_argument('--home', type=Path, default=Path.home())
    diagnosing.add_argument('--agent', choices=['codex'])
    args = parser.parse_args(argv)
    if hasattr(args, 'home'):
        args.home = Path(os.path.abspath(args.home))
    if getattr(args, 'runtime', False) and args.agent != 'codex':
        parser.error('--runtime requires --agent codex')
    for stream in (sys.stdout, sys.stderr):
        stream.reconfigure(encoding='utf-8', newline='\n')  # Windows: cp1252 and CRLF by default
    if args.command == 'render':
        sys.stdout.write(render(args.agent))
    elif args.command == 'install':
        agents = None
        if args.agents is not None:
            agents = set(args.agents.split(','))
            if absent := sorted(agents - detected(args.home)):
                print(f'not found on this PC: {", ".join(absent)}; found: {", ".join(sorted(detected(args.home)))}')
                return 1
        elif args.agent is None and (args.choose or (sys.stdin.isatty() and sys.stdout.isatty() and not saved_choice(args.home))):
            agents = choose_agents(args.home)
            if not agents:
                print('nothing selected, nothing installed')
                return 0
        install(args.home, args.dry_run, args.agent, agents)
    elif args.command == 'restore':
        return restore(args.home, args.stamp)
    elif args.command == 'check':
        return check(args.home, args.agent, args.runtime)
    elif args.command == 'doctor':
        return doctor(args.home, args.agent)


if __name__ == '__main__':
    sys.exit(main())
