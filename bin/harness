#!/usr/bin/env python3
"""Render the agent harness from one source and install it into each agent's home.

  harness render <agent>              print the rendered instructions for one agent
  harness install [--home] [--dry-run] write changed files, backing up what they replace
  harness check [--home]              exit 1 if anything installed drifted or is broken
  harness doctor [--home]             report leftovers and version drift (read-only)
  harness package [--out]             build one ZIP per skill to upload to the Claude app
"""
import sys

if sys.version_info < (3, 11):  # before importing tomllib, which arrived in 3.11
    sys.exit('agent-harness needs Python 3.11 or newer; set `python` in ~/.agent-harness/config.toml '
             'for the hooks and run bin/harness with that interpreter.')

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import time
import tomllib
import zipfile
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
INSTRUCTIONS = REPO / 'core' / 'instructions'
SKILLS = REPO / 'core' / 'skills'
SUBAGENTS = REPO / 'core' / 'agents'
HOOKS = REPO / 'core' / 'hooks'
PLUGINS = tomllib.loads((REPO / 'core' / 'plugins.toml').read_text(encoding='utf-8'))
PERMISSIONS = tomllib.loads((REPO / 'core' / 'permissions.toml').read_text(encoding='utf-8'))
# Hook scripts each agent's hook config runs (Codex also calls the Claude copies).
HOOK_SCRIPTS = {
    '.claude/hooks': ('harness_guards.py', 'enforce_memory_graph.py', 'engram_auto_enroll.py'),
    '.codex/hooks': ('engram_auto_enroll.py',),
}

AGENTS = {
    'claude': {'path': '.claude/CLAUDE.md', 'skills': '.claude/skills', 'marker': 'claude-native',
               'vars': {'agent': 'Claude Code', 'cmd': '/'}},
    # ~/.agents/skills is Codex's documented user folder (~/.codex/skills is deprecated); Copilot and Pi read it too.
    'codex': {'path': '.codex/AGENTS.md', 'skills': '.agents/skills', 'marker': 'codex-native',
              'vars': {'agent': 'Codex', 'cmd': '$'}},
    # OpenCode reads ~/.claude/skills and ~/.agents/skills itself, so it gets no copy of its own.
    'opencode': {'path': '.config/opencode/AGENTS.md', 'skills': None, 'marker': 'opencode-native',
                 'vars': {'agent': 'OpenCode', 'cmd': '/'}},
    # Copilot reads ~/.agents/skills itself.
    'copilot': {'path': '.copilot/copilot-instructions.md', 'skills': None, 'marker': 'copilot-native',
                'vars': {'agent': 'GitHub Copilot', 'cmd': '/'}},
    # Pi reads ~/.agents/skills itself.
    'pi': {'path': '.pi/agent/AGENTS.md', 'skills': None, 'marker': 'pi-native',
           'vars': {'agent': 'Pi', 'cmd': '/skill:'}},
}


# Agent configs the harness merges into; they must stay parseable.
CONFIGS = {
    '.claude/settings.json': json.loads,
    '.codex/config.toml': tomllib.loads,
    '.codex/hooks.json': json.loads,
    '.config/opencode/opencode.json': json.loads,
    '.pi/agent/settings.json': json.loads,
    '.copilot/mcp-config.json': json.loads,
}


def sections(agent):
    """Yield (name, template) in file order; `NN-name.<agent>.md` overrides `NN-name.md`."""
    chosen = {}
    for f in sorted(INSTRUCTIONS.glob('*.md')):
        parts = f.name.split('.')
        if len(parts) == 3 and parts[1] != agent:
            continue
        chosen[parts[0]] = f
    for stem, f in sorted(chosen.items()):
        yield stem.split('-', 1)[1], f.read_text(encoding='utf-8')


def render(agent):
    spec = AGENTS[agent]
    blocks = []
    for name, body in sections(agent):
        for key, value in spec['vars'].items():
            body = body.replace('{{' + key + '}}', value)
        blocks.append(f'<!-- {spec["marker"]}:{name} -->\n{body}<!-- /{spec["marker"]}:{name} -->\n')
    return '\n'.join(blocks)


def agent_file(path, agent):
    """Map `name.<agent>.ext` to `name.ext` for that agent; None when it belongs to another."""
    parts = path.name.split('.')
    for i, part in enumerate(parts[1:-1], 1):
        if part in AGENTS:
            return path.with_name('.'.join(parts[:i] + parts[i + 1:])) if part == agent else None
    return path


def skill_files(agent):
    files = {}
    for f in sorted(SKILLS.rglob('*')):
        if not f.is_file():
            continue
        target = agent_file(f.relative_to(SKILLS), agent)
        if target is not None and (target not in files or target != f.relative_to(SKILLS)):
            files[target] = f.read_bytes()
    return files


def claude_subagent(source, spec):
    lines = ['---', f'name: {source["name"]}', f'description: {json.dumps(spec["description"])}',
             f'model: {spec["model"]}']
    if 'tools' in spec:
        lines.append(f'tools: {spec["tools"]}')
    return '\n'.join(lines) + f'\n---\n\n{fill(source["prompt"], spec)}'


def codex_subagent(source, spec):
    lines = [f'{key} = {json.dumps(value)}' for key, value in (
        ('name', source['name']), ('description', spec['description']), ('model', spec['model']),
        ('model_reasoning_effort', spec['model_reasoning_effort']))]  # Codex ignores sandbox_mode here
    return '\n'.join(lines) + f'\ndeveloper_instructions = """\n{fill(source["prompt"], spec)}"""\n'


def opencode_subagent(source, spec):
    lines = ['---', f'description: {json.dumps(spec["description"])}', 'mode: subagent', 'permission:']
    lines += [f'  {key}: {value}' for key, value in spec['permission'].items()]
    return '\n'.join(lines) + f'\n---\n\n{fill(source["prompt"], spec)}'


def pi_subagent(source, spec):
    lines = ['---', f'name: {source["name"]}', f'description: {json.dumps(spec["description"])}',
             f'tools: {spec["tools"]}',
             # pi-subagents strips AGENTS.md and the skills catalog from user agents unless asked.
             'inheritProjectContext: true', 'inheritSkills: true']
    return '\n'.join(lines) + f'\n---\n\n{fill(source["prompt"], spec)}'


def copilot_subagent(source, spec):
    lines = ['---', f'name: {source["name"]}', f'description: {json.dumps(spec["description"])}']
    return '\n'.join(lines) + f'\n---\n\n{fill(source["prompt"], spec)}'


SUBAGENT_FORMATS = {'claude': ('.claude/agents/{}.md', claude_subagent),
                    'codex': ('.codex/agents/{}.toml', codex_subagent),
                    'opencode': ('.config/opencode/agents/{}.md', opencode_subagent),
                    'pi': ('.pi/agent/agents/{}.md', pi_subagent),
                    'copilot': ('.copilot/agents/{}.agent.md', copilot_subagent)}


def fill(text, spec):
    for key, value in spec.get('vars', {}).items():
        text = text.replace('{{' + key + '}}', value)
    return text


HOOK_CONFIGS = {'claude': '.claude/settings.json', 'codex': '.codex/hooks.json'}
HARNESS_SCRIPTS = {s for scripts in HOOK_SCRIPTS.values() for s in scripts}
SELFTESTED = ('.claude/hooks/harness_guards.py', '.claude/hooks/enforce_memory_graph.py')


def pc_config(home):
    """~/.agent-harness/config.toml: per-PC settings that never go into this repo."""
    config = home / '.agent-harness' / 'config.toml'
    return tomllib.loads(config.read_text(encoding='utf-8')) if config.is_file() else {}


ENGRAM_CLOUD_KEYS = ('ENGRAM_CLOUD_SERVER', 'ENGRAM_CLOUD_AUTOSYNC')


def engram_cloud_env(home):
    """Engram cloud needs the server and autosync in every agent; the token comes from the environment."""
    server = pc_config(home).get('engram_cloud_server')
    return {'ENGRAM_CLOUD_SERVER': server, 'ENGRAM_CLOUD_AUTOSYNC': '1'} if server else {}


def python_for(home):
    """Per-PC interpreter argv: `python` in ~/.agent-harness/config.toml, else py -3 on Windows, else python3."""
    value = pc_config(home).get('python')
    if value:
        return [value.replace('\\', '/')]  # Git Bash eats backslashes
    if os.name == 'nt':  # the launcher survives Python upgrades; python3 there may be the Store stub
        return ['py', '-3'] if shutil.which('py') else [sys.executable.replace('\\', '/')]
    return [shutil.which('python3') or sys.executable]


def hook_key(entry):
    """`script mode` for an entry that runs a harness script; None for anyone else's hook."""
    for hook in entry.get('hooks', []):
        found = re.search(r'/hooks/([\w.]+\.py)["\']?(?:\s+(\S+))?', ' '.join([hook.get('command', ''), *hook.get('args', [])]))
        if found and found[1] in HARNESS_SCRIPTS:
            return f'{found[1]} {found[2] or ""}'.strip()
    return None


def merge_hooks(current, desired):
    """Replace harness entries in place and append missing ones, so other entries keep their index."""
    merged = {}
    for event in [*current, *(e for e in desired if e not in current)]:
        wanted = {hook_key(entry): entry for entry in desired.get(event, [])}
        entries = []
        for entry in current.get(event, []):
            key = hook_key(entry)
            if key is None:
                entries.append(entry)
            elif key in wanted:
                entries.append(wanted.pop(key))
        merged[event] = entries + list(wanted.values())
    return merged


def hook_config(agent, home):
    path = home / HOOK_CONFIGS[agent]
    data = json.loads(path.read_text(encoding='utf-8')) if path.is_file() else {}
    template = (HOOKS / f'{agent}.json').read_text(encoding='utf-8')
    python = python_for(home)
    for key, value in {'python': ' '.join(python), 'claude_hooks': (home / '.claude/hooks').as_posix(),
                       'codex_hooks': (home / '.codex/hooks').as_posix()}.items():
        template = template.replace('{' + key + '}', value)
    desired = json.loads(template)
    for hook in (h for entries in desired.values() for entry in entries for h in entry['hooks']):
        if agent == 'claude':  # exec form: Claude spawns the interpreter itself, with no shell on any OS
            hook['command'], hook['args'] = python[0], python[1:] + hook['args']
        else:  # Codex runs a shell string: sh on POSIX, PowerShell on Windows (which takes cmd-style quotes)
            hook['command'] = (subprocess.list2cmdline if os.name == 'nt' else shlex.join)(python + hook.pop('args'))
    data['hooks'] = merge_hooks(data.get('hooks', {}), desired)
    if agent == 'claude':
        # Subagents may not spawn their own (Claude Code allows 3 levels by default since 2.1.219).
        data.setdefault('env', {})['CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH'] = '1'
        if cloud := engram_cloud_env(home):
            data.setdefault('env', {}).update(cloud)
        else:  # the server was dropped from config.toml: turn the sync off
            for key in ENGRAM_CLOUD_KEYS:
                data.get('env', {}).pop(key, None)
        data.setdefault('enabledPlugins', {}).update(PLUGINS['claude'])
        permissions = data.setdefault('permissions', {})
        for kind in ('deny', 'ask'):
            rules = permissions.setdefault(kind, [])
            rules += [rule for rule in PERMISSIONS['claude'][kind] if rule not in rules]
    return (json.dumps(data, indent=2, ensure_ascii=False) + '\n').encode()


def copilot_hooks(home):
    """Copilot runs `bash` on macOS/Linux and `powershell` on Windows, each one shell string."""
    data = json.loads((HOOKS / 'copilot.json').read_text(encoding='utf-8')
                      .replace('{claude_hooks}', (home / '.claude/hooks').as_posix()))
    shell, join = ('powershell', subprocess.list2cmdline) if os.name == 'nt' else ('bash', shlex.join)
    for entries in data['hooks'].values():
        entries[:] = [{(shell if k == 'args' else k): (join(python_for(home) + v) if k == 'args' else v)
                       for k, v in hook.items()} for hook in entries]
    return (json.dumps(data, indent=2) + '\n').encode()


CODEX_CONFIG = '.codex/config.toml'


def codex_shell_excludes(text):
    """Names in shell_environment_policy.exclude; [] for a missing or malformed value (Codex rejects those)."""
    policy = tomllib.loads(text).get('shell_environment_policy', {})
    exclude = policy.get('exclude', []) if isinstance(policy, dict) else []
    return [n for n in exclude if isinstance(n, str)] if isinstance(exclude, list) else []


def codex_config(home):
    """Flip `enabled` inside each managed plugin table; every other byte stays as written."""
    text = (home / CODEX_CONFIG).read_text(encoding='utf-8')
    for plugin, enabled in PLUGINS['codex'].items():
        table = re.escape(f'[plugins."{plugin}"]')
        text = re.sub(rf'(^{table}\n(?:(?!\[).*\n)*?)enabled = (?:true|false)\n',
                      rf'\g<1>enabled = {str(enabled).lower()}\n', text, count=1, flags=re.M)
    for key in PERMISSIONS['codex']['remove_env']:  # secrets come from the environment instead
        text = re.sub(rf'^{re.escape(key)}\s*=.*\n', '', text, flags=re.M)
    for server, names in PERMISSIONS['codex']['pass_env'].items():
        header = f'[mcp_servers.{server}]\n'
        if header in text and not re.search(rf'^{re.escape(header)}(?:(?!\[).*\n)*?env_vars\s*=', text, re.M):
            # Codex starts stdio MCP servers with a minimal environment; let these through by name.
            text = text.replace(header, header + f'env_vars = {json.dumps(names)}\n', 1)
    # Codex hands its whole environment to shell commands; keep the secrets meant only for MCP servers out.
    secrets = [n for server, names in PERMISSIONS['codex']['pass_env'].items()
               if f'[mcp_servers.{server}]\n' in text for n in names]
    current = codex_shell_excludes(text)
    if missing := [n for n in secrets if n not in current]:
        line = f'exclude = {json.dumps(current + missing)}\n'
        header = re.compile(r'^\[shell_environment_policy\][ \t]*(?:#.*)?\n', re.M)
        existing = re.compile(r'(^\[shell_environment_policy\].*\n(?:(?!\[).*\n)*?)'
                              r'exclude\s*=\s*(?:\[[^\]]*\]|[^\n]*)[^\n]*\n', re.M)  # arrays may span lines
        if existing.search(text):
            candidate = existing.sub(lambda m: m[1] + line, text, count=1)
        elif found := header.search(text):
            candidate = text[:found.end()] + line + text[found.end():]
        else:
            candidate = text.rstrip('\n') + '\n\n[shell_environment_policy]\n' + line
        try:
            if set(secrets) <= set(codex_shell_excludes(candidate)):
                text = candidate
        except ValueError:
            pass  # a layout this cannot edit (dotted keys, inline table): doctor reports it
    table = '[mcp_servers.engram.env]\n'
    def in_table(key):
        return re.compile(rf'(^{re.escape(table)}(?:(?!\[).*\n)*?){re.escape(key)}\s*=.*\n', re.M)
    if (cloud := engram_cloud_env(home)) and '[mcp_servers.engram]\n' in text:
        if table not in text:
            text = text.rstrip('\n') + '\n\n' + table
        for key, value in cloud.items():  # set each key inside that table, leave its other keys alone
            line = f'{key} = {json.dumps(value)}\n'
            existing = in_table(key)
            text = existing.sub(lambda m: m[1] + line, text, count=1) if existing.search(text) \
                else text.replace(table, table + line, 1)
    elif not cloud:  # the server was dropped from config.toml: turn the sync off
        for key in ENGRAM_CLOUD_KEYS:
            text = in_table(key).sub(lambda m: m[1], text, count=1)
    tomllib.loads(text)  # never write a config Codex could not read
    return text.encode()


PI_SETTINGS = '.pi/agent/settings.json'


def pi_settings(home):
    """Drop the ~/.claude/skills entry earlier installs added: Pi reads ~/.agents/skills itself. Keep everything else."""
    data = json.loads((home / PI_SETTINGS).read_text(encoding='utf-8'))
    if isinstance(data.get('skills'), list) and '~/.claude/skills' in data['skills']:
        data['skills'].remove('~/.claude/skills')
    return (json.dumps(data, indent=2, ensure_ascii=False) + '\n').encode()


COPILOT_MCP = '.copilot/mcp-config.json'


def copilot_mcp(home):
    """Add Engram to Copilot's MCP servers when it is missing; None when there is nothing to add."""
    path, engram = home / COPILOT_MCP, shutil.which('engram')
    data = json.loads(path.read_text(encoding='utf-8')) if path.is_file() else {}
    servers = data.setdefault('mcpServers', {})
    if 'engram' in servers or not engram:
        return None  # an entry of the user's own stays as written
    servers['engram'] = {'type': 'local', 'command': engram, 'args': ['mcp', '--tools=agent'], 'tools': ['*']}
    return (json.dumps(data, indent=2, ensure_ascii=False) + '\n').encode()


OPENCODE_CONFIG = '.config/opencode/opencode.json'


def opencode_config(home):
    """Add the harness approval prompts and let the orchestrator call the harness subagents."""
    data = json.loads((home / OPENCODE_CONFIG).read_text(encoding='utf-8'))
    permission = data.setdefault('permission', {})
    if isinstance(permission, dict):
        bash = permission.setdefault('bash', {})
        if isinstance(bash, dict):
            for pattern in PERMISSIONS['opencode']['ask']:
                bash.setdefault(pattern, 'ask')
    task = data.get('agent', {}).get('orchestrator', {}).get('permission', {}).get('task')
    if isinstance(task, dict):
        for f in sorted(SUBAGENTS.glob('*.toml')):
            task.setdefault(f.stem, 'allow')
    return (json.dumps(data, indent=2, ensure_ascii=False) + '\n').encode()


# VS Code's user profile on macOS, Linux, and Windows.
VSCODE_USER = ('Library/Application Support/Code/User', '.config/Code/User', 'AppData/Roaming/Code/User')


def vscode_user(home):
    return next((rel for rel in VSCODE_USER if (home / rel).is_dir()), None)


RULES = '.codex/rules/default.rules'
RULES_BEGIN = '# >>> agent-harness: managed by bin/harness, edit core/hooks/codex.rules\n'
RULES_END = '# <<< agent-harness\n'


def codex_rules(home):
    """Keep the harness rules in one marked block; leave rules Codex added on its own alone."""
    path = home / RULES
    current = path.read_text(encoding='utf-8') if path.is_file() else ''
    block = (HOOKS / 'codex.rules').read_text(encoding='utf-8')
    if RULES_BEGIN in current and RULES_END in current:
        before, rest = current.split(RULES_BEGIN, 1)
        after = rest.split(RULES_END, 1)[1]
    else:  # first install: drop unmarked copies of harness lines left by earlier hand edits
        ours = {line for line in block.splitlines() if line.strip()}
        before = ''.join(l for l in current.splitlines(True) if l.rstrip('\n') not in ours).rstrip('\n')
        before, after = (before + '\n\n' if before else ''), ''
    return (before + RULES_BEGIN + block + RULES_END + after).encode()


# Optional agents get files only on PCs that have them; Claude and Codex are always managed.
OPTIONAL_AGENTS = {'opencode': '.config/opencode', 'pi': '.pi/agent', 'copilot': '.copilot'}


def present(agent, home):
    return agent not in OPTIONAL_AGENTS or (home / OPTIONAL_AGENTS[agent]).is_dir()


def outputs(home):
    """Every file the harness manages, as home-relative path -> bytes."""
    files = {}
    for agent, spec in AGENTS.items():
        if not present(agent, home):
            continue
        files[spec['path']] = render(agent).encode()
        for rel, data in skill_files(agent).items() if spec['skills'] else ():
            files[f'{spec["skills"]}/{rel}'] = data
    for folder, scripts in HOOK_SCRIPTS.items():
        for script in scripts:
            files[f'{folder}/{script}'] = (HOOKS / script).read_bytes()
    files[RULES] = codex_rules(home)
    user = vscode_user(home)
    if present('copilot', home) and user:  # VS Code's local chat reads profile prompts, not ~/.copilot
        header = "---\napplyTo: '**'\ndescription: agent-harness rules (edit the agent-harness repo)\n---\n\n"
        files[f'{user}/prompts/agent-harness.instructions.md'] = (header + render('copilot')).encode()
    if (home / PI_SETTINGS).is_file():
        try:
            files[PI_SETTINGS] = pi_settings(home)
        except ValueError:
            pass  # unparseable config: `check` reports it as invalid
    if (home / OPENCODE_CONFIG).is_file():
        try:
            files[OPENCODE_CONFIG] = opencode_config(home)
        except ValueError:
            pass  # unparseable config: `check` reports it as invalid
    if (home / CODEX_CONFIG).is_file():
        try:
            files[CODEX_CONFIG] = codex_config(home)
        except ValueError:
            pass  # unparseable config: `check` reports it as invalid
    for agent, rel in HOOK_CONFIGS.items():
        try:
            files[rel] = hook_config(agent, home)
        except ValueError:
            pass  # unparseable config: never overwrite it; `check` reports it as invalid
    for f in sorted(SUBAGENTS.glob('*.toml')):
        source = tomllib.loads(f.read_text(encoding='utf-8'))
        for agent, (path, fmt) in SUBAGENT_FORMATS.items():
            if present(agent, home):
                files[path.format(source['name'])] = fmt(source, source[agent]).encode()
    for agent, source, target in (('opencode', 'opencode/agent-harness.ts', '.config/opencode/plugins/agent-harness.ts'),
                                  ('pi', 'pi/agent-harness.ts', '.pi/agent/extensions/agent-harness.ts')):
        if present(agent, home):
            guard = (REPO / 'core' / source).read_text(encoding='utf-8')
            guard = guard.replace('{python}', json.dumps(python_for(home))).replace('{claude_hooks}', (home / '.claude/hooks').as_posix())
            files[target] = guard.encode()
    if present('copilot', home):
        files['.copilot/hooks/agent-harness.json'] = copilot_hooks(home)
        try:
            if mcp := copilot_mcp(home):
                files[COPILOT_MCP] = mcp
        except ValueError:
            pass  # unparseable config: `check` reports it as invalid
    return files


def engram_mcp_commands(home):
    """`claude mcp` argvs that register the Engram MCP when none reaches Claude Code: its plugin stopped shipping
    one in 0.1.16. An entry with no command or url starts nothing, so it is removed first; `add` refuses a taken name."""
    installed, state = home / '.claude/plugins/installed_plugins.json', home / '.claude.json'
    engram = shutil.which('engram')
    try:
        plugin = (json.loads(installed.read_text(encoding='utf-8')).get('plugins', {}).get('engram@engram') or [{}])[0]
        servers = json.loads(state.read_text(encoding='utf-8')).get('mcpServers') or {} if state.is_file() else {}
    except (OSError, ValueError):
        return None  # no plugin, or Claude is rewriting its own state file: leave it alone
    if not engram or not plugin.get('installPath') or (Path(plugin['installPath']) / '.mcp.json').is_file() \
            or isinstance(entry := servers.get('engram'), dict) and (entry.get('command') or entry.get('url')):
        return None
    add = ['claude', 'mcp', 'add', '--transport', 'stdio', '--scope', 'user', 'engram', '--', engram, 'mcp', '--tools=agent']
    return [add] if entry is None else [['claude', 'mcp', 'remove', '--scope', 'user', 'engram'], add]


RETIRED = [line.strip() for line in (REPO / 'core' / 'retired.txt').read_text(encoding='utf-8').splitlines()
           if line.strip() and not line.startswith('#')]
# Codex skills moved to ~/.agents/skills; the old ~/.codex/skills copies would load twice.
RETIRED += [f'.codex/skills/{d.name}' for d in sorted(SKILLS.iterdir()) if d.is_dir()]


def install(home, dry_run=False):
    changed = False
    backup_dir = home / '.agent-harness' / 'backups' / time.strftime('%Y%m%d-%H%M%S')
    for rel in RETIRED:
        stale = home / rel
        if stale.exists():
            changed = True
            if dry_run:
                print(f'would retire {stale}')
                continue
            (backup_dir / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(stale), str(backup_dir / rel))
            print(f'retired {stale} -> {backup_dir / rel}')
    for rel, content in outputs(home).items():
        target = home / rel
        if target.is_file() and target.read_bytes() == content:
            continue
        if dry_run:
            print(f'would install {target}')
            changed = True
            continue
        if target.is_file():
            saved = backup_dir / rel
            saved.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(target, saved)
            print(f'backed up {target} -> {saved}')
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(content)
        print(f'installed {target}')
        changed = True
    if commands := engram_mcp_commands(home):  # Claude owns ~/.claude.json, so its CLI writes the entry
        changed = True
        claude = shutil.which('claude')
        if dry_run:
            print('would register the Engram MCP for Claude Code')
        elif not claude:
            print(f'register the Engram MCP for Claude Code: {" && ".join(map(shlex.join, commands))}')
        else:
            saved = backup_dir / '.claude.json'
            if (home / '.claude.json').is_file():
                saved.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(home / '.claude.json', saved)
                print(f'backed up {home / ".claude.json"} -> {saved}')
            for command in commands:
                result = subprocess.run([claude, *command[1:]], capture_output=True, encoding='utf-8', errors='replace',
                                        timeout=60, env={**os.environ, 'HOME': str(home), 'USERPROFILE': str(home)})
                if result.returncode:
                    break
            print('registered the Engram MCP for Claude Code; restart it' if result.returncode == 0
                  else f'could not register the Engram MCP: {result.stderr.strip() or result.stdout.strip()}')
    if not changed:
        print('no changes')


SECRET_NAME = re.compile(r'token|secret|password|api_?key', re.I)
NOT_SECRET = re.compile(r'tokens$|_env_var$', re.I)  # token counts, names of env vars


def literal_secrets(data, prefix=''):
    """Dotted names of secret-looking keys holding a literal value (the value is never returned)."""
    for key, value in data.items():
        name = f'{prefix}{key}'
        if isinstance(value, dict):
            yield from literal_secrets(value, name + '.')
        elif isinstance(value, str) and value and SECRET_NAME.search(key) and not NOT_SECRET.search(key):
            yield name


def check(home):
    problems = []
    for rel, content in outputs(home).items():
        target = home / rel
        if not target.is_file() or target.read_bytes() != content:
            problems.append(f'drift: {target}')
    problems += [f'stale: {home / rel}' for rel in RETIRED if (home / rel).exists()]
    for rel in SELFTESTED:
        script = home / rel
        if script.is_file():
            result = subprocess.run([*python_for(home), str(script), 'selftest'],
                                    capture_output=True, encoding='utf-8', errors='replace', timeout=60)
            if result.returncode != 0:
                problems.append(f'selftest failed: {script}')
    for rel, parse in CONFIGS.items():
        path = home / rel
        if path.is_file():
            try:
                data = parse(path.read_text(encoding='utf-8'))
            except ValueError as error:  # JSONDecodeError and TOMLDecodeError are ValueErrors
                problems.append(f'invalid: {path}: {error}')
                continue
            scope = {'env': data.get('env', {})} if rel.endswith('settings.json') else data
            problems += [f'secret: {path}: {key}' for key in literal_secrets(scope)]
    for problem in problems:
        print(problem)
    print('ok' if not problems else f'{len(problems)} problem(s); run `harness install` to fix drift')
    return 1 if problems else 0


# Claude Code's own skills; overrides for them are never orphans. New built-ins need adding here.
BUILTIN_SKILLS = {'init', 'review', 'security-review', 'simplify', 'loop', 'schedule', 'claude-api',
                  'update-config', 'keybindings-help', 'fewer-permission-prompts'}


def installed_skill_names(home):
    names = {d.name for d in (home / '.claude/skills').glob('*') if d.is_dir()}
    cache = home / '.claude/plugins/cache'
    for skill in [*cache.glob('*/*/*/skills/*'), *cache.glob('*/*/*/commands/*.md')]:
        plugin, name = skill.parents[2].name, skill.stem  # plugin commands act as skills too
        names |= {name, f'{plugin}:{name}'}
    return names | BUILTIN_SKILLS


def engram_versions(home):
    claude = codex = None
    installed = home / '.claude/plugins/installed_plugins.json'
    if installed.is_file():
        entries = json.loads(installed.read_text(encoding='utf-8')).get('plugins', {}).get('engram@engram') or [{}]
        claude = entries[0].get('version')
    cached = sorted(d.name for d in (home / '.codex/plugins/cache/engram/engram').glob('*') if d.is_dir())
    codex = cached[-1] if cached else None
    binary = update = None
    if shutil.which('engram'):
        out = subprocess.run(['engram', 'version'], capture_output=True, encoding='utf-8', errors='replace', timeout=30)
        binary = (re.search(r'engram v?(\d\S*)', out.stdout) or [None, None])[1]
    if binary and shutil.which('brew'):  # engram prints its own update notice only to a terminal
        out = subprocess.run(['brew', 'info', '--json=v2', 'engram'], capture_output=True, encoding='utf-8', errors='replace', timeout=60)
        try:
            stable = json.loads(out.stdout)['formulae'][0]['versions']['stable']
            update = f'{binary} -> {stable}' if stable != binary else None
        except (ValueError, KeyError, IndexError):
            pass
    return binary, claude, codex, update


def marketplace_version(manifest):
    """Engram plugin version a marketplace manifest offers (Claude lists plugins; Codex has one)."""
    if not manifest.is_file():
        return None
    try:
        data = json.loads(manifest.read_text(encoding='utf-8'))
    except ValueError:
        return None
    for plugin in data.get('plugins', [data]):
        if plugin.get('name', 'engram') == 'engram':
            return plugin.get('version')
    return None


def doctor(home):
    """Report leftovers and version drift; never changes anything."""
    findings = []
    settings = home / '.claude/settings.json'
    if settings.is_file():
        overrides = json.loads(settings.read_text(encoding='utf-8')).get('skillOverrides', {})
        known = installed_skill_names(home)
        findings += [f'orphan skill override: {name} (remove it from skillOverrides in {settings})'
                     for name in overrides if name not in known]
    vscode = home / (vscode_user(home) or VSCODE_USER[0]) / 'settings.json'
    if vscode.is_file():  # JSONC with comments: read the one setting with a regex, never rewrite it
        block = re.search(r'"github\.copilot\.chat\.instructions"\s*:\s*\[(.*?)\]', vscode.read_text(encoding='utf-8'), re.S)
        for path in re.findall(r'~/[^\s",]+', block[1] if block else ''):
            if not (home / path[2:]).exists():
                findings.append(f'github.copilot.chat.instructions points to a missing file: {path} '
                                f'(remove that entry from {vscode})')
    seen, duplicates = set(), []
    for entry in os.environ.get('PATH', '').split(os.pathsep):
        if entry in seen and entry not in duplicates:
            duplicates.append(entry)
        seen.add(entry)
    findings += [f'duplicate PATH entry: {entry} (added twice by your shell startup files)'
                 for entry in duplicates]
    binary, claude, codex, update = engram_versions(home)
    print(f'engram: binary {binary or "not found"}, claude plugin {claude or "-"}, codex plugin {codex or "-"}')
    # Claude and Codex ship separate Engram plugins; compare each with its own marketplace.
    for agent, installed, latest, fix in (
            ('claude', claude, marketplace_version(home / '.claude/plugins/marketplaces/engram/.claude-plugin/marketplace.json'),
             'claude plugin update engram@engram'),
            ('codex', codex, marketplace_version(home / '.codex/.tmp/marketplaces/engram/plugin/codex/.codex-plugin/plugin.json'),
             'codex plugin marketplace upgrade engram && codex plugin add engram@engram')):
        if installed and latest and installed != latest:
            findings.append(f'engram {agent} plugin outdated: {installed} -> {latest} ({fix})')
    if claude := shutil.which('claude'):  # the terminal CLI; the desktop apps update their own copy
        try:
            out = subprocess.run([claude, '--version'], capture_output=True, encoding='utf-8', errors='replace',
                                 timeout=30).stdout
        except (OSError, subprocess.SubprocessError):
            out = ''
        if (found := re.match(r'\s*(\d+)\.(\d+)\.(\d+)', out)) and tuple(map(int, found.groups())) < (2, 1, 295):
            findings.append(f'claude code {".".join(found.groups())} ignores onFailure, so a guard that cannot '
                            'start lets the action through (claude update)')
    codex = home / CODEX_CONFIG
    try:
        exposed = codex.is_file() and 'engram' in tomllib.loads(codex.read_text(encoding='utf-8')).get('mcp_servers', {}) \
            and 'ENGRAM_CLOUD_TOKEN' not in codex_shell_excludes(codex.read_text(encoding='utf-8'))
    except ValueError:
        exposed = False  # unparseable: `check` reports it
    if exposed:
        findings.append(f'Codex shell commands inherit ENGRAM_CLOUD_TOKEN: add it to '
                        f'shell_environment_policy.exclude in {codex}')
    if commands := engram_mcp_commands(home):
        problem = 'is not registered for Claude Code' if len(commands) == 1 else 'for Claude Code has no command'
        findings.append(f'engram MCP {problem}, so its mem_* tools are missing '
                        '(run `bin/harness install` and restart Claude Code)')
    if update:
        findings.append(f'engram update available: {update} (brew upgrade engram)')
    if engram := shutil.which('engram'):  # the status names where the token came from, never its value
        try:
            status = subprocess.run([engram, 'cloud', 'status'], capture_output=True, encoding='utf-8',
                                    errors='replace', timeout=30).stdout
        except (OSError, subprocess.SubprocessError):
            status = ''
        field = lambda name: (re.search(rf'^{name}: (.+)$', status, re.M) or [None, '-'])[1]
        auth = field('Auth status').split(' ')[0]
        print(f'engram cloud: {field("Cloud status")}, server {field("Server")}, auth {auth}')
        if engram_cloud_env(home) and auth != 'ready':
            findings.append('engram cloud is not ready: set ENGRAM_CLOUD_TOKEN for your user '
                            '(README, "Engram cloud token") and restart the agents')
    for finding in findings:
        print(finding)
    if not findings:
        print('no findings')
    return 0


def package(out):
    """Claude's chat and Cowork never read ~/.claude/skills: each skill is uploaded as a ZIP of its folder."""
    out.mkdir(parents=True, exist_ok=True)
    skills = {}
    for rel, data in skill_files('claude').items():
        skills.setdefault(rel.parts[0], {})[rel.as_posix()] = data
    for name, files in sorted(skills.items()):
        with zipfile.ZipFile(out / f'{name}.zip', 'w', zipfile.ZIP_DEFLATED) as z:
            for rel, data in sorted(files.items()):
                z.writestr(rel, data)
    print(f'{len(skills)} skills in {out}; upload each ZIP in the Claude app under Customize > Skills')


def main(argv=None):
    parser = argparse.ArgumentParser(prog='harness')
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('render').add_argument('agent', choices=AGENTS)
    inst = sub.add_parser('install')
    inst.add_argument('--home', type=Path, default=Path.home())
    inst.add_argument('--dry-run', action='store_true')
    sub.add_parser('check').add_argument('--home', type=Path, default=Path.home())
    sub.add_parser('doctor').add_argument('--home', type=Path, default=Path.home())
    sub.add_parser('package').add_argument('--out', type=Path, default=Path.home() / '.agent-harness' / 'claude-app-skills')
    args = parser.parse_args(argv)
    for stream in (sys.stdout, sys.stderr):
        stream.reconfigure(encoding='utf-8', newline='\n')  # Windows: cp1252 and CRLF by default
    if args.command == 'render':
        sys.stdout.write(render(args.agent))
    elif args.command == 'install':
        install(args.home, args.dry_run)
    elif args.command == 'check':
        return check(args.home)
    elif args.command == 'doctor':
        return doctor(args.home)
    elif args.command == 'package':
        package(args.out)


if __name__ == '__main__':
    sys.exit(main())
